<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>DoomSummarizer</RootNamespace>
        <AssemblyName>doomsummarizer</AssemblyName>
        <Version>0.6.1</Version>
        <Authors>Scott Galloway</Authors>
        <Description>AI agent that doom-scrolls HN and Reddit so you don't have to</Description>
        <ApplicationIcon>icon.ico</ApplicationIcon>

        <!-- AOT-friendly single-file deployment -->
        <UseAppHost>true</UseAppHost>
        <PublishSingleFile>true</PublishSingleFile>
        <PublishReadyToRun>true</PublishReadyToRun>
        <!-- LLamaSharp ships multiple AVX-variant native DLLs with the same filename;
             allow last-wins for publish copy, and keep native libs alongside binary
             (also avoids macOS Gatekeeper blocking unsigned extracted dylibs).
             Slim builds (no LLamaSharp) default to true for single-file deployment;
             complete builds default to false to avoid AVX collisions. -->
        <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
        <IncludeNativeLibrariesForSelfExtract Condition="'$(IncludeNativeLibrariesForSelfExtract)' == ''">false</IncludeNativeLibrariesForSelfExtract>
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
        <SelfContained>true</SelfContained>

        <!-- Global tool packaging -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>doomsummarizer</ToolCommandName>
        <PackageId>Mostlylucid.LucidRAG.DoomSummarizer</PackageId>
        <PackageIcon>icon.png</PackageIcon>

        <!-- Allow unsafe for ONNX -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <UserSecretsId>bc19ab4d-717e-4cf3-bdd3-a5ee817de654</UserSecretsId>

    </PropertyGroup>

    <!--
      Four build variants:
        1. dotnet publish ... -c Release                                                                              → doomsummarizer (slim, ~50 MB)
        2. dotnet publish ... -c Release -p:ExcludeGpu=true -p:IncludeNativeLibrariesForSelfExtract=true              → doomsummarizer (slim-nogpu, single exe, ~30 MB)
        3. dotnet publish ... -c Release -p:CompleteBuild=true                                                        → lucidrag (full + GPU, ~1.1 GB)
        4. dotnet publish ... -c Release -p:CompleteBuild=true -p:ExcludeGpu=true                                     → lucidrag (full, CPU-only, ~560 MB)
    -->
    <!-- Slim vs Complete build: CompleteBuild=true includes audio/video/YouTube + LLamaSharp -->
    <PropertyGroup Condition="'$(CompleteBuild)' == 'true'">
        <DefineConstants>$(DefineConstants);FEATURE_COMPLETE</DefineConstants>
        <AssemblyName>lucidrag</AssemblyName>
        <ToolCommandName>lucidrag</ToolCommandName>
        <Description>LucidRAG CLI — full document processing, audio/video analysis, and AI-powered deep research</Description>
    </PropertyGroup>

    <!-- LLamaSharp: included in complete builds by default, opt-in for slim via -p:IncludeLLamaSharp=true -->
    <PropertyGroup>
        <IncludeLLamaSharp Condition="'$(IncludeLLamaSharp)' == '' AND '$(CompleteBuild)' == 'true'">true</IncludeLLamaSharp>
        <IncludeLLamaSharp Condition="'$(IncludeLLamaSharp)' == ''">false</IncludeLLamaSharp>
    </PropertyGroup>
    <PropertyGroup Condition="'$(IncludeLLamaSharp)' == 'true'">
        <DefineConstants>$(DefineConstants);FEATURE_LLAMASHARP</DefineConstants>
    </PropertyGroup>

    <!-- MinVer -->
    <PropertyGroup>
        <MinVerTagPrefix>doomsumcliv</MinVerTagPrefix>
        <MinVerSkip Condition="'$(Configuration)' == 'Debug'">true</MinVerSkip>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MinVer" Version="8.0.0-alpha.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Global using for shared utilities (VectorMath, StopwordLists, etc.) -->
    <ItemGroup>
        <Using Include="Mostlylucid.DocSummarizer.Services.Utilities"/>
    </ItemGroup>

    <!-- Enable test access to internal members -->
    <ItemGroup>
        <InternalsVisibleTo Include="DoomSummarizer.Tests"/>
    </ItemGroup>

    <!-- CLI-only dependencies (always included) -->
    <ItemGroup>
        <PackageReference Include="Spectre.Console" Version="0.54.0"/>
        <PackageReference Include="Spectre.Console.Cli" Version="0.53.1"/>

        <!-- Playwright for JS-rendered sites (browser downloaded via setup, not embedded) -->
        <PackageReference Include="Microsoft.Playwright" Version="1.58.0"/>

        <!-- MCP server for AI agent integration -->
        <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.12" />
    </ItemGroup>

    <!-- Complete-only: email delivery, console image display -->
    <ItemGroup Condition="'$(CompleteBuild)' == 'true'">
        <PackageReference Include="MailKit" Version="4.16.0"/>
        <PackageReference Include="SendGrid" Version="9.29.3"/>
        <PackageReference Include="mostlylucid.consoleimage" Version="4.5.1"/>
        <PackageReference Include="mostlylucid.consoleimage.player" Version="4.5.1"/>
    </ItemGroup>

    <!-- Core references (always included) -->
    <ItemGroup>
        <ProjectReference Include="..\DoomSummarizer.Core\DoomSummarizer.Core.csproj"/>
        <ProjectReference Include="..\Mostlylucid.DocSummarizer.Core\Mostlylucid.DocSummarizer.Core.csproj"/>
        <ProjectReference Include="..\Mostlylucid.LucidRAG.UltraResearch\Mostlylucid.LucidRAG.UltraResearch.csproj"/>
    </ItemGroup>

    <!-- LLamaSharp: local GGUF inference (complete builds, or opt-in with -p:IncludeLLamaSharp=true) -->
    <ItemGroup Condition="'$(IncludeLLamaSharp)' == 'true'">
        <ProjectReference Include="..\Mostlylucid.DocSummarizer.LLamaSharp\Mostlylucid.DocSummarizer.LLamaSharp.csproj"/>
    </ItemGroup>

    <!-- Complete-only: full media pipelines (image/audio/video), YouTube, subtitles, TorchSharp NER -->
    <ItemGroup Condition="'$(CompleteBuild)' == 'true'">
        <ProjectReference Include="..\Mostlylucid.DoomSummarizer.Plugin.Subtitles\Mostlylucid.DoomSummarizer.Plugin.Subtitles.csproj"/>
        <ProjectReference Include="..\Mostlylucid.DoomSummarizer.Source.YouTube\Mostlylucid.DoomSummarizer.Source.YouTube.csproj"/>
        <ProjectReference Include="..\AudioSummarizer.Core\AudioSummarizer.Core.csproj"/>
        <ProjectReference Include="..\ImageSummarizer.Core\ImageSummarizer.Core.csproj"/>
        <ProjectReference Include="..\VideoSummarizer.Core\VideoSummarizer.Core.csproj"/>
        <ProjectReference Include="..\Mostlylucid.GraphRag.TorchSharp\Mostlylucid.GraphRag.TorchSharp.csproj"/>
    </ItemGroup>

    <!-- Exclude complete-only source files from slim builds -->
    <ItemGroup Condition="'$(CompleteBuild)' != 'true'">
        <Compile Remove="Services\ImageService.cs"/>
        <Compile Remove="Services\EmailService.cs"/>
        <Compile Remove="Commands\ScrollCommand.Animation.cs"/>
    </ItemGroup>

    <!-- Slim builds: strip heavyweight native libs from complete-only media pipelines.
         These come transitively via LucidRAG.Core → Image/VideoSummarizer but are unused in slim.
         ExcludeAssets=all prevents the ~90 MB of native DLLs from being published. -->
    <ItemGroup Condition="'$(CompleteBuild)' != 'true'">
        <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260302" ExcludeAssets="all" PrivateAssets="all">
          <IncludeAssets>none</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Whisper.net.Runtime" Version="1.9.0" ExcludeAssets="all" PrivateAssets="all"/>
    </ItemGroup>

    <!-- Embed default config, prompt templates, starter lens files, and manual manifest -->
    <ItemGroup>
        <EmbeddedResource Include="Resources\default-config.json"/>
        <EmbeddedResource Include="Resources\sources.yaml"/>
        <EmbeddedResource Include="Resources\prompts\*.txt"/>
        <EmbeddedResource Include="Resources\lenses\*.lens.yaml"/>
        <EmbeddedResource Include="Resources\manual.manifest.yaml"/>
    </ItemGroup>



    <!-- Package icon -->
    <ItemGroup>
        <None Include="icon.png" Pack="true" PackagePath="">
            <Link>Properties\icon.png</Link>
        </None>
    </ItemGroup>

</Project>
