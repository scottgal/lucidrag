<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Single-target: DataSummarizer.Core (dependency) only supports net10.0 -->
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <!-- Keep old namespace for compatibility until fully migrated -->
        <RootNamespace>Mostlylucid.DocSummarizer.Images</RootNamespace>
        <AssemblyName>ImageSummarizer.Core</AssemblyName>

        <!-- Package metadata -->
        <PackageId>Mostlylucid.LucidRAG.ImageSummarizer</PackageId>
        <PackageIcon>icon.png</PackageIcon>
        <Description>Core image analysis pipeline with OCR, motion detection, and vision model captioning</Description>
        <Authors>Scott Galloway</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/scottgal/lucidrag</PackageProjectUrl>
        <RepositoryUrl>https://github.com/scottgal/lucidrag</RepositoryUrl>
        <PackageTags>image;ocr;vision;imagesharp;clip;florence2;onnx;tesseract</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <!-- MinVer -->
    <PropertyGroup>
        <MinVerTagPrefix>imgsumv</MinVerTagPrefix>
        <MinVerSkip Condition="'$(Configuration)' == 'Debug'">true</MinVerSkip>
    </PropertyGroup>

    <!-- Release configuration: no PDB files -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <!-- MinVer -->
        <PackageReference Include="MinVer" Version="8.0.0-alpha.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <!-- StyloFlow.Retrieval.Core - Universal retrieval infrastructure -->
        <PackageReference Include="Mostlylucid.StyloFlow.Retrieval.Core" Version="2.4.0"/>
    </ItemGroup>

    <!-- Pipeline dependencies (ProjectRef local, PackageRef CI) -->
    <ItemGroup Condition="'$(UseNuGetDependency)' != 'true'">
        <ProjectReference Include="..\Mostlylucid.Summarizer.Core\Mostlylucid.Summarizer.Core.csproj"/>
    </ItemGroup>
    <ItemGroup Condition="'$(UseNuGetDependency)' == 'true'">
        <PackageReference Include="Mostlylucid.LucidRAG.Summarizer.Core" Version="$(CorePackageVersion)"/>
    </ItemGroup>

    <ItemGroup>
        <!-- ONNX Runtime for Florence-2 and CLIP -->
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
        <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.24.4" Condition="'$(ExcludeGpu)' != 'true' AND (('$(RuntimeIdentifier)' == 'win-x64' OR '$(RuntimeIdentifier)' == 'linux-x64') OR (('$(RuntimeIdentifier)' == '') AND ($([MSBuild]::IsOSPlatform('Windows')) OR $([MSBuild]::IsOSPlatform('Linux')))))" NoWarn="NU1605" />
        <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" Condition="'$(ExcludeGpu)' != 'true' AND (('$(RuntimeIdentifier)' == 'win-x64') OR (('$(RuntimeIdentifier)' == '') AND $([MSBuild]::IsOSPlatform('Windows'))))" NoWarn="NU1605" />

        <!-- Florence-2 for fast local image captioning -->
        <PackageReference Include="Florence2" Version="25.12.63049"/>

        <!-- Legacy ephemeral.complete for old code - to be removed after migration -->
        <PackageReference Include="mostlylucid.ephemeral.complete" Version="2.3.2" Aliases="EphemeralComplete"/>
        <PackageReference Include="Mostlylucid.Ephemeral.Atoms.Taxonomy" Version="2.3.2"/>
        <!-- Override vulnerable transitive mail dependencies. -->
        <PackageReference Include="MailKit" Version="4.16.0"/>
        <PackageReference Include="MimeKit" Version="4.16.0"/>

        <!-- Tesseract for OCR -->
        <PackageReference Include="Tesseract" Version="5.2.0"/>

        <!-- Spell checking for OCR quality detection -->
        <PackageReference Include="WeCantSpell.Hunspell" Version="7.0.1"/>

        <!-- SQLite for signal storage -->
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />

        <!-- Override vulnerable transitive dependencies -->
        <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
        <PackageReference Include="Npgsql" Version="10.0.2" />

        <!-- OpenCV for motion analysis -->
        <PackageReference Include="OpenCvSharp4" Version="4.13.0.20260318" />
        <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260302" />
        <PackageReference Include="YamlDotNet" Version="16.3.0"/>
    </ItemGroup>

    <!-- DocSummarizer + DataSummarizer (ProjectRef local, PackageRef CI) -->
    <ItemGroup Condition="'$(UseNuGetDependency)' != 'true'">
        <ProjectReference Include="..\Mostlylucid.DocSummarizer.Core\Mostlylucid.DocSummarizer.Core.csproj"/>
        <ProjectReference Include="..\DataSummarizer.Core\DataSummarizer.Core.csproj"/>
    </ItemGroup>
    <ItemGroup Condition="'$(UseNuGetDependency)' == 'true'">
        <PackageReference Include="Mostlylucid.LucidRAG.DocSummarizer" Version="$(CorePackageVersion)"/>
        <PackageReference Include="Mostlylucid.LucidRAG.DataSummarizer" Version="$(CorePackageVersion)"/>
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Config\pipelines.json"/>
        <EmbeddedResource Include="waves\*.wave.yaml"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include="Pipelines\*.yaml">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- README for NuGet -->
    <ItemGroup>
        <None Include=".\README.md" Pack="true" PackagePath="">
            <Link>Properties\README.md</Link>
        </None>
    </ItemGroup>


    <!-- Package icon -->
    <ItemGroup>
        <None Include="icon.png" Pack="true" PackagePath="">
            <Link>Properties\icon.png</Link>
        </None>
    </ItemGroup>

</Project>
