<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>DoomSummarizer</RootNamespace>

        <!-- NuGet Package Metadata -->
        <IsPackable>true</IsPackable>
        <PackageId>Mostlylucid.LucidRAG.DoomSummarizer.Core</PackageId>
        <Authors>Scott Galloway</Authors>
        <Company>Mostlylucid</Company>
        <Description>Core signal extraction pipeline: embeddings, entities, knowledge graphs, ranking, LLM routing with budget enforcement and circuit-breaking. Builds on Mostlylucid.DocSummarizer for shared NER, content extraction, and RRF scoring.</Description>
        <PackageTags>signal-extraction;rag;llm;knowledge-graph;ner;ranking;rrf;embeddings;onnx;local-first</PackageTags>
        <RepositoryUrl>https://github.com/scottgal/lucidrag</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/release-notes.txt"))</PackageReleaseNotes>

        <!-- Documentation -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>

        <!-- Enable deterministic builds for NuGet -->
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

        <!-- Allow unsafe for ONNX -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <!-- MinVer for automatic versioning -->
    <PropertyGroup>
        <MinVerTagPrefix>doomcorev</MinVerTagPrefix>
    </PropertyGroup>
    <PropertyGroup>
        <MinVerSkip Condition="'$(Configuration)' == 'Debug'">true</MinVerSkip>
    </PropertyGroup>

    <!-- Release configuration: no PDB files for library consumers -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <!-- Global using for shared utilities (VectorMath, StopwordLists, etc.) -->
    <ItemGroup>
        <Using Include="Mostlylucid.DocSummarizer.Services.Utilities"/>
    </ItemGroup>

    <!-- Enable test access to internal members -->
    <ItemGroup>
        <InternalsVisibleTo Include="DoomSummarizer.Tests"/>
        <InternalsVisibleTo Include="doomsummarizer"/>
        <InternalsVisibleTo Include="lucidrag"/>
        <InternalsVisibleTo Include="DoomWriter"/>
        <InternalsVisibleTo Include="Mostlylucid.LucidRAG.UltraResearch.Tests"/>
    </ItemGroup>

    <!-- Core dependencies (Lucene and SQLite now come transitively via backend packages) -->
    <ItemGroup>
        <PackageReference Include="Fluid.Core" Version="2.31.0"/>

        <!-- CLI plugin interface (ICliPlugin uses IConfigurator) -->
        <PackageReference Include="Spectre.Console.Cli" Version="0.53.1"/>
        <PackageReference Include="Microsoft.Recognizers.Text.DateTime" Version="1.8.13"/>
        <PackageReference Include="Microsoft.Recognizers.Text.Number" Version="1.8.13"/>
        <PackageReference Include="Microsoft.Recognizers.Text.Sequence" Version="1.8.13"/>

        <!-- Exclude NuGet.CommandLine pulled transitively by Microsoft.Recognizers.Text — it's a
             tools package not needed at runtime and triggers GHSA-68w7-72jg-6qpp vulnerability warning -->
        <PackageReference Include="NuGet.CommandLine" Version="6.12.2" ExcludeAssets="all" PrivateAssets="all"/>
        <PackageReference Include="SmartReader" Version="0.11.0"/>

        <!-- DuckDB with VSS for HNSW vector search (LucidResearch tier) -->
        <PackageReference Include="DuckDB.NET.Data.Full" Version="1.4.4"/>

        <!-- sqlite-vec for lightweight brute-force vector search (DoomSummarizer CLI tier) -->
        <PackageReference Include="sqlite-vec" Version="0.1.7-alpha.2.1"/>

        <!-- ONNX for local embeddings with GPU auto-detection -->
        <!-- DirectML on Windows (GPU auto-detect), base CPU on other platforms or when GPU excluded -->
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2"
                          Condition="!$([MSBuild]::IsOSPlatform('Windows')) OR '$(ExcludeGpu)' == 'true'"/>
        <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.23.0"
                          Condition="$([MSBuild]::IsOSPlatform('Windows')) AND '$(ExcludeGpu)' != 'true'"/>
        <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0"/>

        <!-- HTML parsing -->
        <PackageReference Include="AngleSharp" Version="1.4.1-beta.506"/>

        <!-- Markdown generation -->
        <PackageReference Include="Markdig" Version="0.44.0"/>

        <!-- Polly for resilience -->
        <PackageReference Include="Polly.Core" Version="8.6.5"/>

        <!-- YAML config -->
        <PackageReference Include="YamlDotNet" Version="16.3.0"/>

        <!-- Logging abstraction -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.2"/>
    </ItemGroup>

    <!-- MinVer -->
    <ItemGroup>
        <PackageReference Include="MinVer" Version="8.0.0-alpha.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Shared LLM routing (LlmRouter, ApiKeyService, ApiRateLimiter) -->
    <ItemGroup Condition="'$(UseNuGetDependency)' != 'true'">
        <ProjectReference Include="..\LucidRAG.LLM\LucidRAG.LLM.csproj"/>
    </ItemGroup>
    <ItemGroup Condition="'$(UseNuGetDependency)' == 'true'">
        <PackageReference Include="Mostlylucid.LucidRAG.LLM" Version="$(CorePackageVersion)"/>
    </ItemGroup>

    <!-- Decomposer: agentic query decomposition engine -->
    <ItemGroup Condition="'$(UseNuGetDependency)' != 'true'">
        <ProjectReference Include="..\LucidRAG.Decomposer\LucidRAG.Decomposer.csproj"/>
    </ItemGroup>
    <ItemGroup Condition="'$(UseNuGetDependency)' == 'true'">
        <PackageReference Include="Mostlylucid.LucidRAG.Decomposer" Version="$(CorePackageVersion)"/>
    </ItemGroup>

    <!-- DocSummarizer + backend packages (conditional: ProjectRef local, PackageRef CI) -->
    <ItemGroup Condition="'$(UseNuGetDependency)' != 'true'">
        <ProjectReference Include="..\Mostlylucid.DocSummarizer.Core\Mostlylucid.DocSummarizer.Core.csproj"/>
        <ProjectReference Include="..\Mostlylucid.DocSummarizer.Anthropic\Mostlylucid.DocSummarizer.Anthropic.csproj"/>
        <ProjectReference Include="..\Mostlylucid.DocSummarizer.OpenAI\Mostlylucid.DocSummarizer.OpenAI.csproj"/>
        <ProjectReference Include="..\Mostlylucid.DocSummarizer.Rdbms.Sqlite\Mostlylucid.DocSummarizer.Rdbms.Sqlite.csproj"/>
        <ProjectReference Include="..\Mostlylucid.DocSummarizer.FullText.Lucene\Mostlylucid.DocSummarizer.FullText.Lucene.csproj"/>
        <ProjectReference Include="..\Mostlylucid.DocSummarizer.FullText.Sqlite\Mostlylucid.DocSummarizer.FullText.Sqlite.csproj"/>
    </ItemGroup>
    <ItemGroup Condition="'$(UseNuGetDependency)' == 'true'">
        <PackageReference Include="Mostlylucid.LucidRAG.DocSummarizer" Version="$(CorePackageVersion)"/>
        <PackageReference Include="Mostlylucid.LucidRAG.DocSummarizer.Anthropic" Version="$(CorePackageVersion)"/>
        <PackageReference Include="Mostlylucid.LucidRAG.DocSummarizer.OpenAI" Version="$(CorePackageVersion)"/>
        <PackageReference Include="Mostlylucid.LucidRAG.DocSummarizer.Rdbms.Sqlite" Version="$(CorePackageVersion)"/>
        <PackageReference Include="Mostlylucid.LucidRAG.DocSummarizer.FullText.Lucene" Version="$(CorePackageVersion)"/>
        <PackageReference Include="Mostlylucid.LucidRAG.DocSummarizer.FullText.Sqlite" Version="$(CorePackageVersion)"/>
    </ItemGroup>

    <!-- Playwright for WebsiteFetcher (JS-rendered sites) -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Playwright" Version="1.58.0"/>
    </ItemGroup>

    <!-- Embed prompt templates and config -->
    <ItemGroup>
        <EmbeddedResource Include="Resources\default-config.json"/>
        <EmbeddedResource Include="Resources\default-config.yaml"/>
        <EmbeddedResource Include="Resources\sources.yaml"/>
        <EmbeddedResource Include="Resources\prompts\*.txt"/>
        <EmbeddedResource Include="Resources\templates\*.yaml"/>
        <EmbeddedResource Include="Resources\profiles\*.json"/>
        <EmbeddedResource Include="Resources\exemplars\*.yaml"/>
    </ItemGroup>

    <!-- Package files -->
    <ItemGroup>
        <None Include=".\README.md" Pack="true" PackagePath="">
            <Link>Properties\README.md</Link>
        </None>
        <None Include=".\release-notes.txt" Pack="true" PackagePath="">
            <Link>Properties\release-notes.txt</Link>
        </None>
    </ItemGroup>

</Project>
