<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <!-- Package metadata -->
        <PackageId>Mostlylucid.LucidRAG.LLM</PackageId>
        <PackageIcon>icon.png</PackageIcon>
        <Description>Unified LLM provider infrastructure for LucidRAG with YAML-based configuration</Description>
        <Authors>Scott Galloway</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/scottgal/lucidrag</PackageProjectUrl>
        <RepositoryUrl>https://github.com/scottgal/lucidrag</RepositoryUrl>
        <PackageTags>llm;ai;openai;anthropic;ollama;lmstudio;yaml;configuration</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <!-- MinVer -->
    <PropertyGroup>
        <MinVerTagPrefix>llmv</MinVerTagPrefix>
        <MinVerSkip Condition="'$(Configuration)' == 'Debug'">true</MinVerSkip>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MinVer" Version="8.0.0-alpha.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Release configuration: no PDB files -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <!-- YAML parsing -->
        <PackageReference Include="YamlDotNet" Version="16.3.0"/>

        <!-- Resilience (Polly) -->
        <PackageReference Include="Polly.Core" Version="8.6.6" />

        <!-- Microsoft Extensions -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    </ItemGroup>

    <!-- LLM service implementations (ProjectRef local, PackageRef CI) -->
    <ItemGroup Condition="'$(UseNuGetDependency)' != 'true'">
        <ProjectReference Include="..\Mostlylucid.DocSummarizer.Core\Mostlylucid.DocSummarizer.Core.csproj"/>
        <ProjectReference Include="..\Mostlylucid.DocSummarizer.Anthropic\Mostlylucid.DocSummarizer.Anthropic.csproj"/>
        <ProjectReference Include="..\Mostlylucid.DocSummarizer.OpenAI\Mostlylucid.DocSummarizer.OpenAI.csproj"/>
    </ItemGroup>
    <ItemGroup Condition="'$(UseNuGetDependency)' == 'true'">
        <PackageReference Include="Mostlylucid.LucidRAG.DocSummarizer" Version="$(CorePackageVersion)"/>
        <PackageReference Include="Mostlylucid.LucidRAG.DocSummarizer.Anthropic" Version="$(CorePackageVersion)"/>
        <PackageReference Include="Mostlylucid.LucidRAG.DocSummarizer.OpenAI" Version="$(CorePackageVersion)"/>
    </ItemGroup>

    <!-- Allow test and consumer projects to access internal members -->
    <ItemGroup>
        <InternalsVisibleTo Include="DoomSummarizer.Tests"/>
        <InternalsVisibleTo Include="doomsummarizer"/>
        <InternalsVisibleTo Include="DoomWriter"/>
    </ItemGroup>

    <!-- README for NuGet -->
    <ItemGroup>
        <None Include=".\README.md" Pack="true" PackagePath="">
            <Link>Properties\README.md</Link>
        </None>
    </ItemGroup>


    <!-- Package icon -->
    <ItemGroup>
        <None Include="icon.png" Pack="true" PackagePath="">
            <Link>Properties\icon.png</Link>
        </None>
    </ItemGroup>

</Project>
