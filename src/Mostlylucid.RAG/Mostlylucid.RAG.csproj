<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>12</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Mostlylucid.RAG</RootNamespace>

        <!-- Package metadata -->
        <PackageId>Mostlylucid.LucidRAG.RAG</PackageId>
        <PackageIcon>icon.png</PackageIcon>
        <Description>Vector store abstraction layer for LucidRAG - DuckDB, Qdrant, InMemory backends</Description>
        <Authors>Scott Galloway</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/scottgal/lucidrag</PackageProjectUrl>
        <RepositoryUrl>https://github.com/scottgal/lucidrag</RepositoryUrl>
        <PackageTags>rag;vector-store;qdrant;duckdb;semantic-search;embeddings</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <!-- MinVer -->
    <PropertyGroup>
        <MinVerTagPrefix>ragv</MinVerTagPrefix>
        <MinVerSkip Condition="'$(Configuration)' == 'Debug'">true</MinVerSkip>
    </PropertyGroup>

    <!-- Release configuration: no PDB files -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MinVer" Version="8.0.0-alpha.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- DocSummarizer.Core (ProjectRef local, PackageRef CI) -->
    <ItemGroup Condition="'$(UseNuGetDependency)' != 'true'">
        <ProjectReference Include="..\Mostlylucid.DocSummarizer.Core\Mostlylucid.DocSummarizer.Core.csproj"/>
    </ItemGroup>
    <ItemGroup Condition="'$(UseNuGetDependency)' == 'true'">
        <PackageReference Include="Mostlylucid.LucidRAG.DocSummarizer" Version="$(CorePackageVersion)"/>
    </ItemGroup>

    <ItemGroup>
        <!-- Versions must match DocSummarizer.Core to avoid downgrade warnings -->
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
        <!-- Qdrant client - only needed if using Qdrant backend -->
        <PackageReference Include="Qdrant.Client" Version="1.17.0" />
    </ItemGroup>

    <!-- README for NuGet -->
    <ItemGroup>
        <None Include=".\README.md" Pack="true" PackagePath="">
            <Link>Properties\README.md</Link>
        </None>
    </ItemGroup>


    <!-- Package icon -->
    <ItemGroup>
        <None Include="icon.png" Pack="true" PackagePath="">
            <Link>Properties\icon.png</Link>
        </None>
    </ItemGroup>

</Project>
