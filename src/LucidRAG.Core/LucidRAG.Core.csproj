<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>LucidRAG</RootNamespace>

        <!-- Package metadata -->
        <PackageId>Mostlylucid.LucidRAG.Core</PackageId>
        <PackageIcon>icon.png</PackageIcon>
        <Description>Core business logic for LucidRAG - shared by web, CLI, and API projects</Description>
        <Authors>Scott Galloway</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/scottgal/lucidrag</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>

        <!-- MinVer -->
        <MinVerTagPrefix>lucidragcorev</MinVerTagPrefix>
        <MinVerSkip Condition="'$(Configuration)' == 'Debug'">true</MinVerSkip>
    </PropertyGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Release'">
        <PackageReference Include="MinVer" Version="8.0.0-alpha.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Entity Framework Core + PostgreSQL + SQLite -->
    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
        <PackageReference Include="Pgvector" Version="0.3.2"/>
        <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0"/>
    </ItemGroup>

    <!-- Identity (for ApplicationUser, no ASP.NET-specific) -->
    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    </ItemGroup>

    <!-- Resilience (Polly) -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.4.0" />
        <PackageReference Include="Microsoft.Extensions.Resilience" Version="10.4.0" />
    </ItemGroup>

    <!-- Microsoft Extensions (logging, config, DI) -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    </ItemGroup>

    <!-- Liquid templates for lens system -->
    <ItemGroup>
        <PackageReference Include="DotLiquid" Version="2.3.197"/>
        <PackageReference Include="YamlDotNet" Version="16.3.0"/>
    </ItemGroup>

    <!-- Project references (local dev) -->
    <ItemGroup Condition="'$(UseNuGetDependency)' != 'true'">
        <ProjectReference Include="..\Mostlylucid.DocSummarizer.Core\Mostlylucid.DocSummarizer.Core.csproj"/>
        <ProjectReference Include="..\ImageSummarizer.Core\ImageSummarizer.Core.csproj"/>
        <ProjectReference Include="..\VideoSummarizer.Core\VideoSummarizer.Core.csproj"/>
        <ProjectReference Include="..\DataSummarizer.Core\DataSummarizer.Core.csproj"/>
        <ProjectReference Include="..\Mostlylucid.DocSummarizer.Anthropic\Mostlylucid.DocSummarizer.Anthropic.csproj"/>
        <ProjectReference Include="..\Mostlylucid.DocSummarizer.OpenAI\Mostlylucid.DocSummarizer.OpenAI.csproj"/>
        <ProjectReference Include="..\Mostlylucid.GraphRag\Mostlylucid.GraphRag.csproj"/>
        <ProjectReference Include="..\Mostlylucid.RAG\Mostlylucid.RAG.csproj"/>
        <ProjectReference Include="..\DoomSummarizer.Core\DoomSummarizer.Core.csproj"/>
        <ProjectReference Include="..\DomainClassifier.Core\DomainClassifier.Core.csproj"/>
    </ItemGroup>

    <!-- NuGet packages (CI / NuGet pack) -->
    <ItemGroup Condition="'$(UseNuGetDependency)' == 'true'">
        <PackageReference Include="Mostlylucid.LucidRAG.DocSummarizer" Version="$(CorePackageVersion)"/>
        <PackageReference Include="Mostlylucid.LucidRAG.DocSummarizer.Anthropic" Version="$(CorePackageVersion)"/>
        <PackageReference Include="Mostlylucid.LucidRAG.DocSummarizer.OpenAI" Version="$(CorePackageVersion)"/>
        <PackageReference Include="Mostlylucid.LucidRAG.DoomSummarizer.Core" Version="$(CorePackageVersion)"/>
        <PackageReference Include="Mostlylucid.LucidRAG.DataSummarizer" Version="$(CorePackageVersion)"/>
        <PackageReference Include="Mostlylucid.LucidRAG.GraphRag" Version="$(CorePackageVersion)"/>
        <PackageReference Include="Mostlylucid.LucidRAG.RAG" Version="$(CorePackageVersion)"/>
        <PackageReference Include="Mostlylucid.LucidRAG.DomainClassifier.Core" Version="$(CorePackageVersion)"/>
        <PackageReference Include="Mostlylucid.LucidRAG.ImageSummarizer" Version="$(CorePackageVersion)"/>
        <PackageReference Include="Mostlylucid.LucidRAG.VideoSummarizer" Version="$(CorePackageVersion)"/>
    </ItemGroup>

    <!-- README for NuGet -->
    <ItemGroup>
        <None Include=".\README.md" Pack="true" PackagePath="">
            <Link>Properties\README.md</Link>
        </None>
    </ItemGroup>


    <!-- Package icon -->
    <ItemGroup>
        <None Include="icon.png" Pack="true" PackagePath="">
            <Link>Properties\icon.png</Link>
        </None>
    </ItemGroup>

</Project>
