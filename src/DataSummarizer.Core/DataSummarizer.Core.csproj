<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>

        <!-- Namespace for now, can change later -->
        <RootNamespace>Mostlylucid.DocSummarizer.Data</RootNamespace>
        <AssemblyName>DataSummarizer.Core</AssemblyName>

        <!-- Package metadata -->
        <PackageId>Mostlylucid.LucidRAG.DataSummarizer</PackageId>
        <PackageIcon>icon.png</PackageIcon>
        <Description>Core data file processing pipeline for CSV, JSON, Excel, Parquet, and SQLite database ingestion with relationship detection</Description>
        <Authors>Scott Galloway</Authors>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/scottgal/lucidrag</PackageProjectUrl>
        <RepositoryUrl>https://github.com/scottgal/lucidrag</RepositoryUrl>
        <PackageTags>data;csv;json;excel;parquet;sqlite;database;ingestion;etl</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <!-- MinVer -->
    <PropertyGroup>
        <MinVerTagPrefix>datasumv</MinVerTagPrefix>
        <MinVerSkip Condition="'$(Configuration)' == 'Debug'">true</MinVerSkip>
    </PropertyGroup>

    <!-- Release configuration: no PDB files -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <!-- MinVer -->
        <PackageReference Include="MinVer" Version="8.0.0-alpha.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <!-- Core dependencies -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.12" />

        <!-- CSV parsing -->
        <PackageReference Include="CsvHelper" Version="33.1.0"/>

        <!-- Excel support -->
        <PackageReference Include="ClosedXML" Version="0.105.0"/>

        <!-- Parquet support -->
        <PackageReference Include="Parquet.Net" Version="5.5.0"/>
        <!-- Pin the patched transitive compression implementation used by Parquet.Net. -->
        <PackageReference Include="Snappier" Version="1.3.1"/>

        <!-- DuckDB for ephemeral streaming analytics -->
        <PackageReference Include="DuckDB.NET.Data" Version="1.5.0" />

        <!-- Statistics library -->
        <PackageReference Include="MathNet.Numerics" Version="6.0.0-beta2"/>

        <!-- SQLite database support -->
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />

        <!-- Access database support - commented out until MMKiwi.MdbReader API stabilizes
        <PackageReference Include="MMKiwi.MdbReader" Version="0.1.0-beta1" />
        -->
    </ItemGroup>

    <!-- Core dependency: ProjectRef local, PackageRef for NuGet builds -->
    <ItemGroup Condition="'$(UseNuGetDependency)' != 'true'">
        <ProjectReference Include="..\Mostlylucid.Summarizer.Core\Mostlylucid.Summarizer.Core.csproj"/>
    </ItemGroup>
    <ItemGroup Condition="'$(UseNuGetDependency)' == 'true'">
        <PackageReference Include="Mostlylucid.LucidRAG.Summarizer.Core" Version="$(CorePackageVersion)"/>
    </ItemGroup>

    <!-- README for NuGet -->
    <ItemGroup>
        <None Include=".\README.md" Pack="true" PackagePath="">
            <Link>Properties\README.md</Link>
        </None>
    </ItemGroup>


    <!-- Package icon -->
    <ItemGroup>
        <None Include="icon.png" Pack="true" PackagePath="">
            <Link>Properties\icon.png</Link>
        </None>
    </ItemGroup>

</Project>
