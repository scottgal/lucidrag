<!-- Widget Demo -->
<section id="widget" class="py-16 lg:py-24 bg-base-200">
    <div class="max-w-7xl mx-auto px-4">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <div>
                <h2 class="text-3xl lg:text-4xl font-bold font-brand mb-6">Embed in 2 lines</h2>
                <p class="text-base-content/60 mb-8">
                    No build step. No npm. Just a script tag with your API key.
                    Shadow DOM keeps our styles out of your way.
                </p>

                <div class="code-block">
                    <div class="flex items-center gap-2 px-4 py-2 border-b border-slate-700">
                        <span class="w-3 h-3 rounded-full bg-red-500"></span>
                        <span class="w-3 h-3 rounded-full bg-yellow-500"></span>
                        <span class="w-3 h-3 rounded-full bg-green-500"></span>
                        <span class="text-slate-400 text-xs ml-2 font-brand">index.html</span>
                    </div>
<pre><code><span class="comment">&lt;!-- Add where you want search --&gt;</span>
<span class="tag">&lt;div</span> <span class="attr">id</span>=<span class="string">"lucidrag-search"</span><span class="tag">&gt;&lt;/div&gt;</span>
<span class="tag">&lt;script</span> <span class="attr">src</span>=<span class="string">"https://search.lucidrag.com/widget/lucidrag-search.js"</span>
        <span class="attr">data-api-key</span>=<span class="string">"lrag_your_key_here"</span>
        <span class="attr">data-mode</span>=<span class="string">"both"</span>
        <span class="attr">data-theme</span>=<span class="string">"auto"</span><span class="tag">&gt;</span>
<span class="tag">&lt;/script&gt;</span></code></pre>
                </div>

                <div class="mt-6 space-y-2">
                    <div class="flex items-center gap-3 text-sm">
                        <span class="badge badge-primary badge-sm font-brand">data-mode</span>
                        <span class="text-base-content/60">"search" | "chat" | "both"</span>
                    </div>
                    <div class="flex items-center gap-3 text-sm">
                        <span class="badge badge-primary badge-sm font-brand">data-theme</span>
                        <span class="text-base-content/60">"light" | "dark" | "auto"</span>
                    </div>
                    <div class="flex items-center gap-3 text-sm">
                        <span class="badge badge-primary badge-sm font-brand">data-position</span>
                        <span class="text-base-content/60">"inline" | "floating"</span>
                    </div>
                </div>
            </div>

            <div>
                <div class="mockup-browser border border-base-300 bg-base-100">
                    <div class="mockup-browser-toolbar">
                        <div class="input border border-base-300 text-sm font-brand">https://your-docs-site.com</div>
                    </div>
                    <div class="bg-base-100 p-6">
                        <p class="text-base-content/40 text-sm mb-4">Your existing page content...</p>
                        <div class="border border-base-300 rounded-lg overflow-hidden">
                            <div class="flex items-center gap-2 px-3 py-2.5 border-b border-base-200">
                                <svg class="h-4 w-4 text-base-content/40" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                                <span class="text-sm text-base-content/40 font-brand">Search docs...</span>
                            </div>
                            <div class="p-3 space-y-2">
                                <div class="bg-base-200/50 rounded p-2.5">
                                    <div class="font-medium text-xs">Getting Started Guide</div>
                                    <div class="text-[11px] text-base-content/50 mt-0.5">Install the SDK and configure your first project in under 5 minutes...</div>
                                </div>
                                <div class="bg-base-200/50 rounded p-2.5">
                                    <div class="font-medium text-xs">Configuration Reference</div>
                                    <div class="text-[11px] text-base-content/50 mt-0.5">Full list of configuration options for the YAML config file...</div>
                                </div>
                            </div>
                            <div class="text-center text-[9px] text-base-content/30 py-1.5 border-t border-base-200">
                                Powered by <span class="font-brand"><span class="italic">lucid</span><span class="font-bold">RAG</span></span>
                            </div>
                        </div>
                        <p class="text-base-content/40 text-sm mt-4">...more of your page</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
