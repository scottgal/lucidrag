<!-- Features Section -->
<section id="features" class="py-16 lg:py-24">
    <div class="max-w-7xl mx-auto px-4">
        <div class="text-center mb-12">
            <h2 class="text-3xl lg:text-4xl font-bold font-brand mb-4">What you get</h2>
            <p class="text-base-content/60 max-w-2xl mx-auto">Point us at your content. We do the rest. No GPU required.</p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="card bg-base-100 shadow-sm border border-base-200 hover:-translate-y-0.5 transition-transform">
                <div class="card-body">
                    <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-3">
                        <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                    </div>
                    <h3 class="font-bold font-brand">Hybrid Search</h3>
                    <p class="text-sm text-base-content/60">Semantic vectors + BM25 keyword search fused with RRF. Better results than either alone.</p>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm border border-base-200 hover:-translate-y-0.5 transition-transform">
                <div class="card-body">
                    <div class="w-10 h-10 rounded-lg bg-secondary/10 flex items-center justify-center mb-3">
                        <svg class="h-5 w-5 text-secondary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
                    </div>
                    <h3 class="font-bold font-brand">AI Chat</h3>
                    <p class="text-sm text-base-content/60">RAG-powered conversations grounded in your documents. Sources cited, hallucinations minimized.</p>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm border border-base-200 hover:-translate-y-0.5 transition-transform">
                <div class="card-body">
                    <div class="w-10 h-10 rounded-lg bg-accent/10 flex items-center justify-center mb-3">
                        <svg class="h-5 w-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                    </div>
                    <h3 class="font-bold font-brand">2-Line Embed</h3>
                    <p class="text-sm text-base-content/60">Drop a script tag on your site. Shadow DOM isolates styles. No build step, no npm, no dependencies.</p>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm border border-base-200 hover:-translate-y-0.5 transition-transform">
                <div class="card-body">
                    <div class="w-10 h-10 rounded-lg bg-info/10 flex items-center justify-center mb-3">
                        <svg class="h-5 w-5 text-info" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <h3 class="font-bold font-brand">Auto-Indexing</h3>
                    <p class="text-sm text-base-content/60">Point at a domain or GitHub repo. We crawl, extract, chunk, and embed automatically.</p>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm border border-base-200 hover:-translate-y-0.5 transition-transform">
                <div class="card-body">
                    <div class="w-10 h-10 rounded-lg bg-success/10 flex items-center justify-center mb-3">
                        <svg class="h-5 w-5 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
                    </div>
                    <h3 class="font-bold font-brand">Corpus Isolation</h3>
                    <p class="text-sm text-base-content/60">Each API key gets its own corpus. Your data never leaks to other users' results.</p>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm border border-base-200 hover:-translate-y-0.5 transition-transform">
                <div class="card-body">
                    <div class="w-10 h-10 rounded-lg bg-warning/10 flex items-center justify-center mb-3">
                        <svg class="h-5 w-5 text-warning" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
                    </div>
                    <h3 class="font-bold font-brand">Smart System, Tiny LLMs</h3>
                    <p class="text-sm text-base-content/60">Our system is smart so LLMs can be small. 0.6B models handle decomposition and response assembly. No GPU needed to run.</p>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm border border-base-200 hover:-translate-y-0.5 transition-transform">
                <div class="card-body">
                    <div class="w-10 h-10 rounded-lg bg-error/10 flex items-center justify-center mb-3">
                        <svg class="h-5 w-5 text-error" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
                    </div>
                    <h3 class="font-bold font-brand">PII Filter Built In</h3>
                    <p class="text-sm text-base-content/60">Personal data is automatically detected and stripped before indexing. Always on for free tier. Configurable for paid plans.</p>
                </div>
            </div>

            <div class="card bg-base-100 shadow-sm border border-base-200 hover:-translate-y-0.5 transition-transform">
                <div class="card-body">
                    <div class="w-10 h-10 rounded-lg bg-primary/10 flex items-center justify-center mb-3">
                        <svg class="h-5 w-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                    </div>
                    <h3 class="font-bold font-brand">ETag-Aware Updates</h3>
                    <p class="text-sm text-base-content/60">Manual re-index on free tier (one button). Paid plans get scheduled re-indexing down to every 15 minutes.</p>
                </div>
            </div>
        </div>
    </div>
</section>
