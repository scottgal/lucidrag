{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=ragdocs;Username=raguser;Password=ragpassword"
  },
  "RagDocuments": {
    "RequireApiKey": false,
    "ApiKey": "",
    "UploadPath": "./uploads",
    "MaxFileSizeMB": 2000,
    "AllowedExtensions": [
      ".pdf",
      ".docx",
      ".md",
      ".txt",
      ".html",
      ".gif",
      ".png",
      ".jpg",
      ".jpeg",
      ".webp",
      ".svg",
      ".csv",
      ".xlsx",
      ".xls",
      ".parquet",
      ".db",
      ".sqlite",
      ".json",
      ".xml",
      ".mp4",
      ".mkv",
      ".avi",
      ".mov",
      ".webm",
      ".mp3",
      ".wav",
      ".flac",
      ".m4a",
      ".ogg"
    ]
  },
  "DocSummarizer": {
    "EmbeddingBackend": "Onnx",
    "LlmBackend": "Ollama",
    "Deduplication": {
      "Retrieval": {
        "MinRelevanceScore": 0.0
      }
    },
    "BertRag": {
      "VectorStore": "Qdrant",
      "CollectionName": "ragdocs",
      "PersistVectors": true,
      "ReuseExistingEmbeddings": true,
      "ReindexOnStartup": false
    },
    "Onnx": {
      "ExecutionProvider": "Auto",
      "EmbeddingModel": "AllMiniLmL6V2"
    },
    "Ollama": {
      "BaseUrl": "http://localhost:11434",
      "Model": "qwen2.5:3b",
      "DefaultSynthesisProfile": "gpu16gb",
      "SynthesisProfiles": {
        "CpuOnly": {
          "Model": "gemma2:2b",
          "MaxTokens": 512,
          "Temperature": 0.3,
          "Description": "CPU-only (16GB RAM) - Fast responses with tiny models"
        },
        "Gpu8Gb": {
          "Model": "gemma3:4b",
          "MaxTokens": 1024,
          "Temperature": 0.3,
          "Description": "8GB VRAM - Balanced quality for consumer GPUs"
        },
        "Gpu16Gb": {
          "Model": "gemma3:12b",
          "MaxTokens": 2048,
          "Temperature": 0.3,
          "Description": "16GB VRAM (A4000/RTX 4080) - High quality for prosumer GPUs"
        },
        "Gpu24Gb": {
          "Model": "qwen3:14b",
          "MaxTokens": 4096,
          "Temperature": 0.3,
          "Description": "24GB VRAM (RTX 4090/A5000) - Premium quality"
        },
        "Enterprise": {
          "Model": "gemma3:12b",
          "MaxTokens": 8192,
          "Temperature": 0.3,
          "Description": "32GB+ VRAM / 128GB RAM - Enterprise grade"
        }
      }
    },
    "Qdrant": {
      "Host": "localhost",
      "Port": 6334,
      "CollectionName": "ragdocs",
      "VectorSize": 384
    },
    "Docling": {
      "Enabled": false,
      "BaseUrl": "http://localhost:5001",
      "TimeoutSeconds": 300,
      "EnableSplitProcessing": true,
      "PagesPerChunk": 50,
      "MaxConcurrentChunks": 2,
      "PdfBackend": "pypdfium2",
      "OcrPdfBackend": "docling",
      "EnableOcrFallback": true,
      "MinPagesForSplit": 60,
      "AutoDetectGpu": true,
      "Documents": {
        "Enabled": true,
        "Extensions": [".pdf", ".docx", ".pptx", ".xlsx", ".html"],
        "Priority": 20
      },
      "Images": {
        "Enabled": true,
        "Extensions": [".png", ".jpg", ".jpeg", ".tiff", ".tif", ".webp", ".bmp"],
        "UseAsPrimaryOcr": false
      },
      "Audio": {
        "Enabled": true,
        "Extensions": [".wav", ".mp3", ".m4a", ".flac", ".ogg"],
        "UseAsPrimaryTranscription": false
      }
    }
  },
  "Images": {
    "Mode": "Caption",
    "EnableOcr": true,
    "EnableClipEmbedding": true,
    "TextLikelinessThreshold": 0.4,
    "ModelsDirectory": "./models",
    "MaxImageSize": 2048,
    "ThumbnailSize": 256,
    "ColorGrid": {
      "Rows": 3,
      "Cols": 3,
      "TargetWidth": 384,
      "SampleStep": 2,
      "BucketBits": 4
    },
    "SupportedExtensions": [
      ".jpg",
      ".jpeg",
      ".png",
      ".gif",
      ".webp",
      ".bmp",
      ".tiff"
    ],
    "Ocr": {
      "UseAdvancedPipeline": false,
      "QualityMode": "Fast",
      "ConfidenceThresholdForEarlyExit": 0.95,
      "EnableStabilization": true,
      "EnableBackgroundSubtraction": false,
      "EnableEdgeConsensus": false,
      "EnableTemporalMedian": true,
      "EnableSuperResolution": false,
      "EnableTextDetection": false,
      "EnableTemporalVoting": true,
      "EnablePostCorrection": false,
      "MaxFramesForSuperResolution": 5,
      "MaxFramesForVoting": 10,
      "StabilizationConfidenceThreshold": 0.7,
      "SsimDeduplicationThreshold": 0.95,
      "NmsIouThreshold": 0.3,
      "TextDetectionConfidenceThreshold": 0.5,
      "TextDetectionPadding": 4,
      "SaveIntermediateImages": false,
      "IntermediateOutputDirectory": "./ocr-debug",
      "EmitPerformanceMetrics": true,
      "EnableLightOnOcr": false,
      "LightOnOcrBaseUrl": "http://localhost:11434",
      "LightOnOcrModelName": "aipib/LightOnOCR-1B-1025",
      "LightOnOcrAsPrimary": false,
      "LightOnOcrTimeoutSeconds": 120,
      "LightOnOcrMaxTokens": 4096,
      "LightOnOcrPreferMarkdown": true
    }
  },
  "Audio": {
    "TranscriptionBackend": "Whisper",
    "Verbose": false,
    "FingerprintProvider": "PureNet",
    "EnableVoiceEmbeddings": false,
    "EnableSpeakerDiarization": false,
    "EnableSourceSeparation": false,
    "SupportedFormats": [".mp3", ".wav", ".m4a", ".flac", ".ogg", ".wma", ".aac"],
    "Whisper": {
      "ModelSize": "base",
      "Language": "en"
    },
    "Pipeline": {
      "EnableFingerprinting": true,
      "EnableAcousticProfiling": true,
      "EnableContentClassification": true,
      "EnableTranscription": true
    }
  },
  "EvidenceStorage": {
    "BasePath": null,
    "DefaultProvider": "filesystem",
    "TemporaryArtifactRetentionDays": 7,
    "ProcessingLogRetentionDays": 30
  },
  "LfuCache": {
    "EvidenceCacheCapacity": 1000,
    "EntityCacheCapacity": 500,
    "MaxMemoryPerTenantMB": 50,
    "EnableStatistics": true,
    "EntryTtlMinutes": 60
  },
  "Multitenancy": {
    "Enabled": true,
    "AllowDefaultTenant": true,
    "AutoProvisionTenants": true,
    "BaseDomain": "lucidrag.com"
  },
  "Sentinel": {
    "Enabled": true,
    "TinyModel": "gemma3:1b",
    "EscalationModel": "qwen3:8b",
    "OllamaBaseUrl": "http://localhost:11434",
    "MaxTokens": 1024,
    "Temperature": 0.1,
    "ClarificationThreshold": 0.4,
    "CachePlans": true,
    "PlanCacheTtl": "00:15:00"
  },
  "Anthropic": {
    "ApiKey": "${ANTHROPIC_API_KEY}",
    "Model": "claude-3-5-haiku-latest",
    "MaxTokens": 4096,
    "Temperature": 0.3
  },
  "OpenAI": {
    "ApiKey": "${OPENAI_API_KEY}",
    "Model": "gpt-4o-mini",
    "EmbeddingModel": "text-embedding-3-small",
    "MaxTokens": 4096,
    "Temperature": 0.3
  },
  "Prompts": {
    "SystemPrompts": {
      "Default": "You are a helpful assistant that answers questions based on the provided documents. Always cite your sources using [1], [2], etc.",
      "Technical": "You are a technical documentation expert. Provide precise, code-focused answers with examples. Always cite sources.",
      "Research": "You are a research assistant. Provide comprehensive analysis with multiple perspectives. Always cite sources.",
      "Concise": "You are a concise assistant. Provide brief, direct answers in 1-2 sentences. Always cite sources."
    },
    "QueryClarification": {
      "Enabled": true,
      "AmbiguityThreshold": 0.7
    },
    "QueryDecomposition": {
      "Enabled": true,
      "MaxSubQueries": 5
    },
    "SelfCorrection": {
      "Enabled": true,
      "MaxRetries": 2
    },
    "ResponseSynthesis": {
      "IncludeSources": true,
      "MaxSourcesPerResponse": 10
    }
  },
  "Lenses": {
    "Directory": "./manifests/lenses",
    "DefaultLens": "blog",
    "EnableHotReload": false
  },
  "Waves": {
    "Directory": "./manifests/waves"
  },
  "Processors": {
    "Directory": "./manifests/processors"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
