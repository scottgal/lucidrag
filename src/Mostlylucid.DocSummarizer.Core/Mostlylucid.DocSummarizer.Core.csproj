<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <RootNamespace>Mostlylucid.DocSummarizer</RootNamespace>

        <!-- NuGet Package Metadata -->
        <IsPackable>true</IsPackable>
        <PackageId>Mostlylucid.LucidRAG.DocSummarizer</PackageId>
        <Authors>Scott Galloway</Authors>
        <Company>Mostlylucid</Company>
        <Description>Local-first document summarization library using BERT embeddings, RAG, and optional LLM synthesis. Supports markdown, PDF, DOCX, and URLs. Every claim is grounded with citations. Runs entirely offline with ONNX models, or optionally uses Ollama/Docling for enhanced features.</Description>
        <PackageTags>summarization;rag;bert;embeddings;llm;ollama;document-processing;markdown;pdf;onnx;local-first</PackageTags>
        <RepositoryUrl>https://github.com/scottgal/mostlylucidweb/tree/main/Mostlylucid.DocSummarizer.Core</RepositoryUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
        <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/release-notes.txt"))</PackageReleaseNotes>

        <!-- Documentation -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>

        <!-- Enable deterministic builds for NuGet -->
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

        <!-- Allow unsafe for ONNX interop -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <!-- StyloFlow.Retrieval.Core for BM25, TF-IDF, RRF, cross-modal entities -->
    <ItemGroup>
        <PackageReference Include="Mostlylucid.StyloFlow.Retrieval.Core" Version="2.4.0"/>
        <PackageReference Include="ReverseMarkdown" Version="5.2.0" />
        <PackageReference Include="SmartReader" Version="0.11.0"/>
    </ItemGroup>

    <!-- Slim build support: when CompleteBuild=false, exclude heavy optional deps -->
    <PropertyGroup Condition="'$(CompleteBuild)' == 'false'">
        <DefineConstants>$(DefineConstants);SLIM_BUILD</DefineConstants>
    </PropertyGroup>

    <!-- Summarizer.Core (always included) -->
    <ItemGroup Condition="'$(UseNuGetDependency)' != 'true'">
        <ProjectReference Include="..\Mostlylucid.Summarizer.Core\Mostlylucid.Summarizer.Core.csproj"/>
    </ItemGroup>
    <ItemGroup Condition="'$(UseNuGetDependency)' == 'true'">
        <PackageReference Include="Mostlylucid.LucidRAG.Summarizer.Core" Version="$(CorePackageVersion)"/>
    </ItemGroup>

    <!-- Storage.Core for DuckDB persistent vector store adapter -->
    <ItemGroup Condition="'$(UseNuGetDependency)' != 'true'">
        <ProjectReference Include="..\Mostlylucid.Storage.Core\Mostlylucid.Storage.Core.csproj"/>
    </ItemGroup>
    <ItemGroup Condition="'$(UseNuGetDependency)' == 'true'">
        <PackageReference Include="Mostlylucid.LucidRAG.Storage.Core" Version="$(CorePackageVersion)"/>
    </ItemGroup>

    <!-- CodeSummarizer: tree-sitter code analysis (~50MB native grammars, excluded in slim) -->
    <ItemGroup Condition="'$(UseNuGetDependency)' != 'true' AND '$(CompleteBuild)' != 'false'">
        <ProjectReference Include="..\CodeSummarizer.Core\CodeSummarizer.Core.csproj"/>
    </ItemGroup>
    <ItemGroup Condition="'$(UseNuGetDependency)' == 'true' AND '$(CompleteBuild)' != 'false'">
        <PackageReference Include="Mostlylucid.LucidRAG.CodeSummarizer" Version="$(CorePackageVersion)"/>
    </ItemGroup>

    <!-- MinVer for automatic versioning -->
    <PropertyGroup>
        <MinVerTagPrefix>docsumv</MinVerTagPrefix>
    </PropertyGroup>
    <PropertyGroup>
        <MinVerSkip Condition="'$(Configuration)' == 'Debug'">true</MinVerSkip>
    </PropertyGroup>

    <!-- Release configuration: no PDB files for library consumers -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <!-- Package dependencies -->
    <ItemGroup>
        <!-- MinVer -->
        <PackageReference Include="MinVer" Version="8.0.0-alpha.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <!-- Core dependencies - .NET 10 -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
        <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.5" />
        <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.5" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.5" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.5" />
        <PackageReference Include="Polly.Core" Version="8.6.6" />

        <!-- OpenTelemetry for observability -->
        <PackageReference Include="OpenTelemetry.Api" Version="1.18.0" />

        <!-- ML/Embeddings -->
        <!-- ONNX Runtime: DirectML on Windows (GPU auto-detect), base CPU on other platforms or when GPU excluded -->
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.23.2"
                          Condition="!$([MSBuild]::IsOSPlatform('Windows')) OR '$(ExcludeGpu)' == 'true'"/>
        <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" Condition="$([MSBuild]::IsOSPlatform('Windows')) AND '$(ExcludeGpu)' != 'true'" />
        <PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.0"/>
        <PackageReference Include="Markdig" Version="1.1.2" />

        <!-- Document Processing (lightweight: PDF text + HTML) -->
        <PackageReference Include="PdfPig" Version="0.1.14" />
        <PackageReference Include="AngleSharp" Version="1.8.1"/>

        <!-- Web Fetching (for URL processing with JS-rendered pages) -->
        <PackageReference Include="Microsoft.Playwright" Version="1.58.0"/>

        <!-- Vector Storage -->
        <PackageReference Include="Qdrant.Client" Version="1.17.0" />

        <!-- Utilities -->
        <PackageReference Include="System.IO.Hashing" Version="10.0.5" />
        <PackageReference Include="dotnet-stop-words" Version="1.1.0"/>

        <!-- YAML parsing for wave manifests -->
        <PackageReference Include="YamlDotNet" Version="16.3.0"/>

        <!-- Override vulnerable transitive dependency from Qdrant.Client -->
        <PackageReference Include="Newtonsoft.Json" Version="13.0.4"/>
    </ItemGroup>

    <!-- DOCX support: included in ALL builds (small dependency, high value) -->
    <ItemGroup>
        <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    </ItemGroup>

    <!-- Heavy optional deps: PDF-to-image, image processing (excluded in slim builds) -->
    <ItemGroup Condition="'$(CompleteBuild)' != 'false'">
        <PackageReference Include="PDFtoImage" Version="5.2.0"/>
        <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12"/>
    </ItemGroup>

    <!-- Exclude source files that depend entirely on heavy optional packages -->
    <ItemGroup Condition="'$(CompleteBuild)' == 'false'">
        <Compile Remove="Services\DocxTableExtractor.cs"/>
        <Compile Remove="Services\PptxDocumentHandler.cs"/>
        <Compile Remove="Services\PdfPageRenderer.cs"/>
        <Compile Remove="Services\DoclingClient.cs"/>
        <Compile Remove="Scanning\Waves\VlmOcrWave.cs"/>
    </ItemGroup>

    <!-- Embed word list resources -->
    <ItemGroup>
        <EmbeddedResource Include="Resources\*.txt"/>
    </ItemGroup>

    <!-- Embed document scanning wave and pipeline YAML definitions -->
    <ItemGroup>
        <EmbeddedResource Include="Scanning\Waves\*.wave.yaml"/>
        <EmbeddedResource Include="Scanning\Pipelines\*.yaml"/>
    </ItemGroup>

    <!-- Copy Python table extractor scripts to output -->
    <ItemGroup>
        <None Include="Resources\TableExtractors\*.py">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Pack>true</Pack>
            <PackagePath>lib\$(TargetFramework)\Resources\TableExtractors</PackagePath>
        </None>
    </ItemGroup>

    <!-- Package files -->
    <ItemGroup>
        <None Include=".\icon.png" Pack="true" PackagePath="">
            <Link>Properties\icon.png</Link>
        </None>
        <None Include=".\README.md" Pack="true" PackagePath="">
            <Link>Properties\README.md</Link>
        </None>
        <None Include=".\release-notes.txt" Pack="true" PackagePath="">
            <Link>Properties\release-notes.txt</Link>
        </None>
    </ItemGroup>

    <!-- Icon content -->
    <ItemGroup>
        <Content Update="icon.png">
            <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        </Content>
    </ItemGroup>

</Project>
