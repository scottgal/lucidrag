<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>preview</LangVersion>
        <RootNamespace>CodeSummarizer.Mermaid.Jint</RootNamespace>

        <!-- NuGet Package Metadata -->
        <IsPackable>true</IsPackable>
        <PackageId>Mostlylucid.LucidRAG.CodeSummarizer.Mermaid.Jint</PackageId>
        <PackageIcon>icon.png</PackageIcon>
        <Authors>Scott Galloway</Authors>
        <Company>Mostlylucid</Company>
        <Description>100% spec-conformant Mermaid diagram parsing using Jint (pure .NET JavaScript interpreter) running mermaid.js in-process. Drop-in replacement for the regex-based MermaidParser with automatic fallback.</Description>
        <PackageTags>mermaid;jint;javascript;diagram;parsing;rag;codesummarizer</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/release-notes.txt"))</PackageReleaseNotes>

        <!-- Documentation -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);1591</NoWarn>

        <!-- Deterministic builds -->
        <Deterministic>true</Deterministic>
        <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    </PropertyGroup>

    <!-- MinVer -->
    <PropertyGroup>
        <MinVerTagPrefix>codemermaidv</MinVerTagPrefix>
        <MinVerSkip Condition="'$(Configuration)' == 'Debug'">true</MinVerSkip>
    </PropertyGroup>

    <!-- Release configuration: no PDB files -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <!-- MinVer -->
        <PackageReference Include="MinVer" Version="8.0.0-alpha.1">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <!-- Jint - pure .NET JavaScript interpreter -->
        <PackageReference Include="Jint" Version="4.7.0" />

        <!-- Core dependencies -->
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    </ItemGroup>

    <!-- CodeSummarizer.Core dependency (conditional: ProjectRef local, PackageRef CI) -->
    <ItemGroup Condition="'$(UseNuGetDependency)' != 'true'">
        <ProjectReference Include="..\CodeSummarizer.Core\CodeSummarizer.Core.csproj"/>
    </ItemGroup>
    <ItemGroup Condition="'$(UseNuGetDependency)' == 'true'">
        <PackageReference Include="Mostlylucid.LucidRAG.CodeSummarizer" Version="$(CorePackageVersion)"/>
    </ItemGroup>

    <!-- Embedded mermaid JS bundle -->
    <ItemGroup>
        <EmbeddedResource Include="Resources\mermaid-parser-bundle.js"/>
    </ItemGroup>

    <!-- Package files -->
    <ItemGroup>
        <None Include=".\release-notes.txt" Pack="true" PackagePath="">
            <Link>Properties\release-notes.txt</Link>
        </None>
    </ItemGroup>


    <!-- Package icon -->
    <ItemGroup>
        <None Include="icon.png" Pack="true" PackagePath="">
            <Link>Properties\icon.png</Link>
        </None>
    </ItemGroup>

</Project>
